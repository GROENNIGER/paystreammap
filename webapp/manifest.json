        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "rtl.paystreammap.paystreammap.view",
        "async": true,
        "viewPath": "rtl.paystreammap.paystreammap.view"
      },
      "routes": [
        {
          "name": "Routepaystreammap",
          "pattern": ":?query:",
          "target": [
            "Targetpaystreammap"
          ]
        }
      ],
      "targets": {
        "Targetpaystreammap": {
          "id": "paystreammap",
          "name": "paystreammap"
        }
      }
    },
    "rootView": {
      "viewName": "rtl.paystreammap.paystreammap.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
